# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file. See internal/platform/config/config.go for
# validation rules (required vars, minimum secret length, and the
# production guard against leaving this placeholder JWT_SECRET in place).

# Deployment environment: development | staging | production.
# Defaults to "development" when unset.
APP_ENV=development

# TCP port the HTTP server listens on. Defaults to "8080" when unset.
PORT=8080

# Postgres connection string. REQUIRED, no default.
DATABASE_URL=postgres://mesaposta:mesaposta@localhost:5432/mesaposta?sslmode=disable

# Secret used to sign/verify access tokens. REQUIRED, must be at least 32
# bytes. The value below is a placeholder ONLY: internal/platform/config
# refuses to start with this exact value when APP_ENV=production.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Postgres connection pool tuning (all optional; defaults shown below).
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s
